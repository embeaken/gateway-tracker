{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "eslint.config.ts",
    "netlify/functions/**/*",
    "src/earthcam.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "module": "ESNext",
    "moduleResolution": "Bundler"
  }
}
